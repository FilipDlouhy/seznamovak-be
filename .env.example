# Django
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# The 2026 site calls the API on its own origin, so the host of the site must be allowed
DJANGO_ALLOWED_HOSTS=seznamovak.utb.cz
DJANGO_CSRF_TRUSTED_ORIGINS=https://seznamovak.utb.cz
DJANGO_USE_HTTPS=true

# Database
POSTGRES_DB=seznamovak
POSTGRES_USER=seznamovak
POSTGRES_PASSWORD=change-me

# Host port of the web container (put a reverse proxy with HTTPS in front of it)
WEB_PORT=8002

# Email (SMTP in production; the console backend prints emails to the container log)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Seznamovák UTB <seznamovak@sutb.cz>

# Public host of the site, used in the cancel link of the emails
SEZNAMOVAK_PUBLIC_URL=https://seznamovak.utb.cz

# Newsletter: contacts are added to this Brevo list only when the key is set
BREVO_API_KEY=
BREVO_LIST_ID=3

# Camp edition, prices and payment data (used in the e-mails and the payment QR codes)
SEZNAMOVAK_YEAR=2026
SEZNAMOVAK_EDITION=devátý
SEZNAMOVAK_PRICE_TOTAL_CZK=3399
SEZNAMOVAK_PRICE_TOTAL_EUR=145
# Deposit is paid by bank transfer, the balance in cash on arrival
SEZNAMOVAK_DEPOSIT_CZK=2399
SEZNAMOVAK_DEPOSIT_EUR=102
SEZNAMOVAK_BALANCE_CZK=1000
# Working days, as in the participation conditions
SEZNAMOVAK_PAYMENT_DEADLINE_DAYS=5
SEZNAMOVAK_ACCOUNT_CZK=2301459738/2010
SEZNAMOVAK_IBAN_CZK=CZ3720100000002301459738
SEZNAMOVAK_ACCOUNT_EUR=2501459740/2010
SEZNAMOVAK_IBAN_EUR=CZ7120100000002501459740
SEZNAMOVAK_VARIABLE_SYMBOL=2026767
